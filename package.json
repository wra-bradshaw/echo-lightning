{
  "name": "echo360-lightning",
  "description": "A lightweight, same-origin Echo360 replacement interface.",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && pnpm assert:build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assert:build": "node --experimental-strip-types tools/build/assert-build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:discovery": "pnpm run build && pnpm exec playwright test --project=discovery",
    "test:e2e:extension": "pnpm run build && pnpm exec playwright test --project=extension",
    "debug:app": "node --experimental-strip-types .agents/skills/debug-authenticated-app/scripts/debug-app.ts",
    "check": "pnpm format:check && pnpm lint && tsc --noEmit && knip && pnpm test && pnpm build",
    "test:e2e": "pnpm run build && pnpm exec playwright test",
    "test:e2e:headed": "pnpm run build && HEADED=1 pnpm exec playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.18",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
